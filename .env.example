# EGX Trading System — Environment template
# Copy: cp .env.example .env  then fill secrets locally (never commit .env)

# ── Telegram Bot (required for client delivery) ───────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Python Bridge ─────────────────────────────────────────────────────────────
# Cron prefers /usr/bin/python3 with numpy+lightgbm+lifelines+duckdb
PYTHON_BIN=python3
PYTHON3=python3
PY_TIMEOUT=120000

# ── TradingView MCP / CDP ─────────────────────────────────────────────────────
# macOS: TV Desktop may need Chrome fallback for CDP
TV_CDP_BROWSER=chrome
TV_CDP_PORT=9222
TV_CDP_URL=https://www.tradingview.com/chart/?symbol=EGX_DLY:COMI

# ── Automation ────────────────────────────────────────────────────────────────
DAILY_RUN_TIME=16:30
AUTO_NOTIFY=true
EGX_ALERT_TELEGRAM=1
EGX_OPS_SUCCESS_ALERT=1
EGX_AUTO_BACKFILL=0

# ── Safety / portfolio gates ──────────────────────────────────────────────────
EGX_SAFETY_VETO=1
EGX_MAX_SIGNALS_PER_DAY=3
EGX_MAX_OPEN_POSITIONS=6
EGX_PAPER_TRADING=true
EGX_PORTFOLIO_AUTO=1

# ── Shadow engines (1=enabled, 0=disabled) ────────────────────────────────────
EGX_MDE_ENABLED=1
EGX_LRE_ENABLED=1
EGX_MED_ENABLED=1
# Shadow invariants — do not enable client path from research engines
EGX_MDE_SHADOW=1
EGX_LRE_SHADOW=1
EGX_LRE_OPP_BOOST=0
MED_SHADOW=1
MED_CLIENT_SIGNAL=0
MED_OPP_BOOST=0
MED_FEED_BOOST=0
EGX_LRE_FEED_BOOST=1

# ── Phase 14 — operator bundle (applied via npm run egx:env:activate-phase14) ─
EGX_PHASE11_AUTO_PROMOTE=1
EGX_MED_CLIENT_SHADOW=1
EGX_MDE_PILOT_PROMOTE=1
EGX_P6_GRADUATION_MODE=historical_bootstrap
EGX_MED_SHADOW_BACKFILL=1

# Phase 11 — auto-apply graduation gate recommendations when gates PASS
# EGX_PHASE11_AUTO_PROMOTE=1

# Phase 12 — P6 graduation mode (default: historical_bootstrap, not live-only wait)
# EGX_P6_GRADUATION_MODE=historical_bootstrap
# EGX_P6_BOOTSTRAP_MIN_N=3
# EGX_P6_BOOTSTRAP_MIN_WR=60
# strict_live = require full 30/30 live samples (legacy blocker mode)
# EGX_P6_GRADUATION_MODE=strict_live
# Emergency override when gate not PASS (logged in data/research_client_env.json)
# EGX_RESEARCH_ENV_FORCE=1

# Phase 13 — live validation pilots (shadow only, non-blocking)
# EGX_MED_CLIENT_SHADOW=1
# EGX_MED_CLIENT_SHADOW_SESSIONS=5
# EGX_MDE_PILOT_PROMOTE=1
# EGX_MED_AB_STREAK_TARGET=5
# EGX_MDE_PILOT_STABILITY_DAYS=14

# ── Optional overrides ────────────────────────────────────────────────────────
# EGX_DB_PATH=data/egx_trading.db
# EMAIL_API_KEY=
# EMAIL_FROM=egx-system@yourdomain.com
# EMAIL_TO=
# EXCHANGE_RATE_API_KEY=
